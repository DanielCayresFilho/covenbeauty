# ─────────────────────────────────────────────
# Coven Beauty — variáveis de ambiente
# Copie para `.env` e ajuste os valores
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Postgres
POSTGRES_USER=coven
POSTGRES_PASSWORD=coven_dev_secret
POSTGRES_DB=coven_beauty
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Prisma usa esta URL. Em Docker, troque host por "postgres".
DATABASE_URL=postgresql://coven:coven_dev_secret@localhost:5432/coven_beauty?schema=public

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — gere segredos fortes em produção: `openssl rand -base64 48`
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
JWT_REFRESH_EXPIRES_IN=7d

# Usuário administrador inicial (usado pelo seed)
ADMIN_EMAIL=admin@covenbeauty.com
ADMIN_PASSWORD=Coven@Admin123
ADMIN_FULL_NAME=Suma Sacerdotisa

# E-mail transacional (Brevo) — usado no "esqueci minha senha"
BREVO_API_KEY=
MAIL_FROM_EMAIL=nao-responda@covenbeauty.com
MAIL_FROM_NAME=Coven Beauty
# Validade do código de reset de senha
PASSWORD_RESET_TTL_MINUTES=15
